{
    "actorSpecification": 1,
    "name": "siftstack-propertyradar",
    "title": "SiftStack — REI Operations Platform",
    "description": "Real estate investing lead acquisition for VA/MD. PropertyRadar list pulls, Virginia Press Association notices, Chesterfield ACA code violations, and the Richmond Vacant Building List — enriched (Smarty, Zillow, obituary/heir research, skip trace, Trestle phone scoring) and pushed into the DataSift CRM.",
    "version": "1.0",
    "buildTag": "latest",
    "input": "./input_schema.json",
    "dockerfile": "../Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "SiftStack Records",
            "views": {
                "overview": {
                    "title": "Overview",
                    "transformation": {
                        "fields": [
                            "date_added",
                            "address",
                            "city",
                            "state",
                            "zip",
                            "owner_name",
                            "notice_type",
                            "county",
                            "mls_status",
                            "estimated_value",
                            "estimated_equity",
                            "property_type",
                            "source_url"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "date_added": { "label": "Date", "format": "text" },
                            "address": { "label": "Address", "format": "text" },
                            "city": { "label": "City", "format": "text" },
                            "owner_name": { "label": "Owner", "format": "text" },
                            "notice_type": { "label": "Type", "format": "text" },
                            "county": { "label": "County", "format": "text" },
                            "mls_status": { "label": "MLS Status", "format": "text" },
                            "estimated_value": { "label": "Zestimate", "format": "text" },
                            "estimated_equity": { "label": "Est. Equity", "format": "text" },
                            "property_type": { "label": "Prop Type", "format": "text" }
                        }
                    }
                }
            }
        }
    }
}
